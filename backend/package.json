{
  "name": "buildtrack-pro-backend",
  "version": "1.0.0",
  "description": "Backend API for BuildTrack Pro",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "9.0.3",
    "multer": "2.2.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "jest": "30.4.2",
    "nodemon": "3.1.14",
    "supertest": "7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/__tests__/helpers/"
    ]
  }
}
